# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or paste real keys into a public file.

# Supabase project URL and anon publishable key (from the Supabase dashboard, Project Settings, API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Gemini API key (from Google AI Studio). Primary provider for the Ask Scout chatbot.
GEMINI_API_KEY=your-gemini-api-key

# OpenRouter API key (from openrouter.ai). Fallback provider for the Ask Scout chatbot.
OPENROUTER_API_KEY=your-openrouter-api-key
